[Unit]
Description=Back up K3s application data to Azure Blob (encrypted)
After=network-online.target k3s.service
Wants=network-online.target
RequiresMountsFor=/srv/standard

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --exclusive --nonblock /run/k3s-application-backup/lock /usr/local/sbin/k3s-application-backup
User=root
Group=root
RuntimeDirectory=k3s-application-backup
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite needs write access to the WAL index of the databases it copies.
ReadWritePaths=/srv/standard/backups/k3s-applications /srv/standard/volumes/uptime-kuma /srv/standard/volumes/monitoring /var/lib/node_exporter/textfile_collector
