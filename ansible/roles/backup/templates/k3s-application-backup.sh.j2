#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly backup_root=/srv/standard/backups/k3s-applications
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
readonly timestamp
hostname="$(hostname -s)"
readonly hostname
readonly work_dir="${backup_root}/.${timestamp}"
readonly archive="${backup_root}/${hostname}-apps-${timestamp}.tar.gz.age"
readonly blob_url="https://{{ backup_storage_account }}.blob.core.windows.net/{{ backup_storage_container }}/k3s-applications/${hostname}/${hostname}-apps-${timestamp}.tar.gz.age"
readonly volumes=/srv/standard/volumes

# ProtectHome hides ~/.kube, so keep the discovery cache in the private /tmp.
kubectl() { /usr/local/bin/k3s kubectl --cache-dir=/tmp/kube-cache "$@"; }

# Backup freshness for Prometheus (node-exporter textfile collector).
readonly metrics_dir=/var/lib/node_exporter/textfile_collector
write_backup_metrics() {
    local name="$1" file="${metrics_dir}/backup-$1.prom"
    {
        printf '# HELP polinetwork_backup_last_success_timestamp_seconds Unix time of the last successful backup upload.\n'
        printf '# TYPE polinetwork_backup_last_success_timestamp_seconds gauge\n'
        printf 'polinetwork_backup_last_success_timestamp_seconds{backup="%s"} %s\n' "$name" "$(date +%s)"
        printf '# HELP polinetwork_backup_last_size_bytes Size of the last uploaded encrypted backup.\n'
        printf '# TYPE polinetwork_backup_last_size_bytes gauge\n'
        printf 'polinetwork_backup_last_size_bytes{backup="%s"} %s\n' "$name" "$(stat -c %s "$archive")"
    } > "${file}.tmp"
    # node-exporter runs as nobody; the script umask would hide the file.
    chmod 0644 "${file}.tmp"
    mv -- "${file}.tmp" "$file"
}

cleanup() {
    exit_code=$?
    rm -rf -- "$work_dir"
    find "$backup_root" -maxdepth 1 -type f \
      -mtime +{{ backup_local_retention_days }} -delete || true
    trap - EXIT
    exit "$exit_code"
}
trap cleanup EXIT

mkdir -p -- "$work_dir"

# PostgreSQL: roles plus a transaction-consistent dump of every database.
# shellcheck disable=SC2016 # expands inside the container
kubectl --namespace=postgres exec deploy/postgres -- \
  sh -c 'pg_dumpall --username="$POSTGRES_USER" --clean --if-exists' \
  > "${work_dir}/postgres-dumpall.sql"
grep --quiet -- '-- PostgreSQL database cluster dump complete' "${work_dir}/postgres-dumpall.sql"

# Redis: point-in-time RDB snapshots taken over the replication protocol.
redis_snapshot() {
    kubectl --namespace="$1" exec "deploy/$2" --container="$2" -- \
      sh -c 'redis-cli --rdb /tmp/backup.rdb >/dev/null && cat /tmp/backup.rdb && rm -f /tmp/backup.rdb'
}
redis_snapshot redis redis > "${work_dir}/redis.rdb"
redis_snapshot bot-ts bot-ts-redis > "${work_dir}/bot-ts-redis.rdb"

# InfluxDB: the official online backup.
kubectl --namespace=influxdb exec deploy/influxdb -- \
  sh -c 'rm -rf /tmp/influx-backup && influx backup /tmp/influx-backup >/dev/null && tar -C /tmp/influx-backup -cf - . && rm -rf /tmp/influx-backup' \
  > "${work_dir}/influxdb-backup.tar"

# SQLite applications: consistent online copies plus their remaining files.
sqlite_backup() {
    local dir="$1" db="$2" name="$3"
    sqlite3 "${dir}/${db}" ".backup '${work_dir}/${name}.db'"
    tar -C "$dir" --exclude="./${db}" --exclude="./${db}-*" --exclude=./lost+found \
      -cf "${work_dir}/${name}-files.tar" .
}
sqlite_backup "${volumes}/uptime-kuma/uptime-pvc" kuma.db uptime-kuma
sqlite_backup "${volumes}/monitoring/grafana-pvc" grafana.db grafana

(cd "$work_dir" && sha256sum -- * > SHA256SUMS)

# Only the age identity in kv-pn-infra can decrypt the archive.
tar -C "$work_dir" -cf - . | gzip | age --recipient "{{ backup_age_recipient }}" > "$archive"
sha256sum "$archive" > "${archive}.sha256"
archive_sha256="$(cut -d ' ' -f 1 "${archive}.sha256")"

access_token="$({
    curl --fail --silent --show-error \
      --header Metadata:true \
      "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2019-08-01&resource=https%3A%2F%2Fstorage.azure.com%2F&client_id={{ backup_identity_client_id }}"
} | jq --exit-status --raw-output .access_token)"
readonly auth_header="${work_dir}/azure-authorization.header"
printf 'Authorization: Bearer %s\n' "$access_token" > "$auth_header"
chmod 0600 "$auth_header"
unset access_token

curl --fail --silent --show-error \
  --request PUT \
  --header "@${auth_header}" \
  --header "x-ms-date: $(LC_ALL=C date -u '+%a, %d %b %Y %H:%M:%S GMT')" \
  --header "x-ms-version: 2023-11-03" \
  --header "x-ms-blob-type: BlockBlob" \
  --header "x-ms-meta-sha256: ${archive_sha256}" \
  --header "Content-Type: application/octet-stream" \
  --data-binary "@${archive}" \
  "$blob_url"

write_backup_metrics applications
