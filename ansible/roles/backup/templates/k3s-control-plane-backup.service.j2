[Unit]
Description=Back up K3s SQLite state and server token to Azure Blob
After=network-online.target k3s.service
Wants=network-online.target
RequiresMountsFor=/srv/standard

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --exclusive --nonblock /run/k3s-control-plane-backup.lock /usr/local/sbin/k3s-control-plane-backup
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/standard/backups/k3s-control-plane
