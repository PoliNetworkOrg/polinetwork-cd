KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=replace-with-random-value
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=replace-with-random-value
KOMODO_WEBHOOK_SECRET=replace-with-random-value
KOMODO_JWT_SECRET=replace-with-random-value
KOMODO_HOST=https://komodo.invalid
KOMODO_TITLE=PoliNetwork Komodo Lab
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=true
KOMODO_TRANSPARENT_MODE=false
KOMODO_FIRST_SERVER_NAME=vm01
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
KOMODO_JWT_TTL=1-day
KOMODO_MONITORING_INTERVAL=15-sec
KOMODO_RESOURCE_POLL_INTERVAL=1-hr
TZ=Europe/Rome
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=vm01
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/srv/polinetwork/compose
PERIPHERY_DISABLE_TERMINALS=true
PERIPHERY_DISABLE_CONTAINER_EXEC=true
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
