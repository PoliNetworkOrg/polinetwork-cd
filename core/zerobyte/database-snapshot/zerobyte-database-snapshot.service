[Unit]
Description=Create a consistent Zerobyte SQLite snapshot for off-host backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/srv/polinetwork/compose/polinetwork-cd/core/zerobyte/database-snapshot/snapshot.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/polinetwork/state/backup-staging
